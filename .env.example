# ============================================================================
# M365-Copilot2API 环境变量参考(复制为 .env 后按需修改)
#
# 除标注「必配」的变量外,全部可选(源码均有安全默认值)。此处示例值仅供
# 部署参考,不是作者的真实密钥。
#
# 注意:启动时 <M365_DATA_DIR>/settings.json 中的持久化设置会覆盖这些
# 环境变量(settings.json 在默认值之上二次反序列化)。要让环境变量反向压过
# 控制台设置,设 M365_SETTINGS_ENV_WINS=true(默认不要设)。
# ============================================================================

# ---------------------------------------------------------------------------
# 核心服务与数据布局
# ---------------------------------------------------------------------------

# HTTP 监听地址,Web 控制台与 OpenAI 兼容 API 都在这里。(默认 0.0.0.0:4141)
M365_LISTEN=127.0.0.1:4141

# 数据目录:token 缓存、账户、会话、对话、用量统计、备份。
# 务必放在 Git 仓库之外。
M365_DATA_DIR=/var/lib/m365-copilot2api

# 以下路径不设置时默认解析到 M365_DATA_DIR 内部。
# M365_CONFIG=accounts.json                       # 账户/凭据存储
# M365_TOKEN_CACHE=tokens.json                    # OAuth token 缓存
# M365_TOKEN_FILE=                                # 备用 token 存储路径
# M365_SESSION_CACHE=sessions.json                # 会话解析器绑定记录
# M365_ACTIVE_SESSION_CACHE=                      # 活跃会话快速存储
# M365_USER_SESSION_CACHE=user_sessions.json      # 按用户会话存储
# M365_CONVERSATION_CACHE=conversations.json      # 对话管理器记录
# M365_USAGE_LOG=usage.jsonl                      # 请求/用量日志
# M365_DEBUG_LOG=                                 # 详细调试日志路径(空=关)

# 日志级别:debug / info / warn / error(默认 info)
M365_LOG_LEVEL=info

# /v1/* 端点接受的 API Key(逗号分隔)。示例:M365_API_KEYS=sk-aaa,sk-bbb
M365_API_KEYS=sk-你的key

# ---------------------------------------------------------------------------
# OAuth / Microsoft 身份(账户通过 Web 控制台添加)
# ---------------------------------------------------------------------------

# 旧版单应用注册(浏览器/设备 ID 未设置时的回退)
# M365_CLIENT_ID=
# M365_AUTHORITY=https://login.microsoftonline.com/common
# M365_REDIRECT_URI=
# M365_SCOPE=openid profile offline_access User.Read
# M365_AUTHORIZE_ENDPOINT=
# M365_TOKEN_ENDPOINT=

# 浏览器 PKCE 流程应用注册
M365_BROWSER_CLIENT_ID=
M365_BROWSER_AUTHORITY=https://login.microsoftonline.com/common
M365_BROWSER_SCOPE=openid profile offline_access
M365_BROWSER_REDIRECT_URI=https://login.microsoftonline.com/common/oauth2/nativeclient

# 设备码流程应用注册
M365_DEVICE_CLIENT_ID=
M365_DEVICE_AUTHORITY=https://login.microsoftonline.com/common
M365_DEVICE_SCOPE=openid profile offline_access
M365_DEVICE_ENDPOINT=
M365_DEVICE_TOKEN_ENDPOINT=

# refresh token / 备份加密。不设则用内置回退密钥(单机部署够用;
# 多机或备份场景务必设真实密钥)
# M365_MASTER_KEY=换成至少32字节的密钥
# M365_TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# 必配!Cloudflare 前置部署的会话稳定性
# ---------------------------------------------------------------------------
# 缺少这两项时,Cloudflare 后面的每个请求都会解析成「新会话」:账号每轮
# 轮询、conv-cache miss、每条消息一个云对话、同一对话框拆成多个账号。
#
# 只信任来自 Cloudflare 边沿网段的 X-Forwarded-For(取真实客户端 IP)。
# 取值:"cloudflare"(推荐)或逗号分隔的 CIDR 列表。
M365_TRUSTED_PROXIES=cloudflare

# 会话指纹基础。ua = hash(User-Agent),CF 后面稳定;
# ip_ua(默认)= hash(IP+UA),CF 边沿 IP 漂移时会散;
# off/none = 空指纹(仅内容匹配)。
M365_FINGERPRINT_MODE=ua

# ---------------------------------------------------------------------------
# 工具规划与路由
# ---------------------------------------------------------------------------
# router(默认,推荐):网关用 modelToolRouterPrompt 让上游模型做 JSON 工具
#   决策,再把标准 tool_calls 交给客户端。M365 上游对原生透传支持是坏的:
#   tools 原样透传会返回空完成(502),或编造「容器执行」叙事而非 tool_calls。
# native:tools/tool_choice 直接透传给上游 ChatHub(不推荐)。
M365_TOOL_PLANNING_MODE=router

# 每轮工具调用数 / 每会话最大工具轮次(默认 32 / 512)
# M365_MAX_TOOL_CALLS_PER_TURN=32
# M365_MAX_TOOL_ROUNDS=512

# ---------------------------------------------------------------------------
# 上下文窗口与超时
# ---------------------------------------------------------------------------
# contextWindow 采用 120000(实测验证):2026-09-26 对上游 M365 做过阶梯压测,
# 输入 414 → 69,326 tokens 全部 200、零退化、输出质量一致;更早的 usage 记录里
# 529K input 也返回过 200。此前 60000 的建议是过度保守(源自一次特定会话被上游
# 冻结的误诊),已推翻。budget = contextWindow - maxOutputTokens - 512。
M365_CONTEXT_WINDOW=120000
M365_MAX_OUTPUT_TOKENS=8192

# M365_MAX_CONVERSATION_MESSAGES=600
# M365_CHAT_TIMEOUT_SECONDS=120
# M365_IMAGE_TIMEOUT_SECONDS=150
# M365_RATE_LIMIT_COOLDOWN_SECONDS=30

# 上游 tone / 场景 / 许可证
# M365_SCENARIO=OfficeWebIncludedCopilot
# M365_LICENSE_TYPE=Starter

# ---------------------------------------------------------------------------
# 对话生命周期 / 自动清理(云对话卫生)
# ---------------------------------------------------------------------------
# 后台循环每 interval 执行:删除(a)闲置超过 max_age 的对话,(b)超过 keep_n
# 的最旧对话。最近用过和已白名单的对话永不清理。
M365_AUTO_CLEANUP=1
M365_AUTO_CLEANUP_INTERVAL_MINUTES=30
M365_AUTO_CLEANUP_MAX_AGE_HOURS=2
M365_AUTO_CLEANUP_KEEP_N=5

# 旧版对话管理器清理旋钮(进阶)
# M365_CLEANUP_MODE=            # CleanupOnExit(默认)|CleanupAfterResponse|CleanupMaxAge|CleanupKeepN
# M365_CLEANUP_KEEP_N=5
# M365_CLEANUP_MAX_AGE_HOURS=24

# 会话 / TTL 调优
# M365_SESSION_TTL_MINUTES=120
# M365_CONTEXT_TTL_MINUTES=120
# M365_USER_SESSION_TTL_MINUTES=30
# M365_PERSIST_INTERVAL=5s

# ---------------------------------------------------------------------------
# 出站代理(可选;WARP/SOCKS/HTTP 代理走上游调用)
# ---------------------------------------------------------------------------
# M365_OUTBOUND_PROXY=http://127.0.0.1:40000
# M365_PROXY_POOL=http://p1:8080,http://p2:8080
# M365_PROXY_INSECURE_TLS=false
# M365_PROXY_HEALTH_URL=

# ---------------------------------------------------------------------------
# 管理端安全
# ---------------------------------------------------------------------------
# Web 控制台 / 管理 API 必需的管理员密码。绝不要提交真实值。
M365_ADMIN_PASSWORD=换成强密码

# 备用密码来源(keyring/引导文件方式)
# M365_ADMIN_PASSWORD_FILE=
# M365_ADMIN_PASSWORD_BOOTSTRAP_FILE=
# M365_REQUIRE_STRONG_ADMIN_PASSWORD=true

# ---------------------------------------------------------------------------
# 功能开关(全部默认 false)
# ---------------------------------------------------------------------------
# M365_ENABLE_MEMORY_V2=false
# M365_ENABLE_DEEP_WORK=false
# M365_ENABLE_COMPUTER_USE=false
# M365_ENABLE_REALTIME_VOICE=false
# M365_ENABLE_SYSTEM_PROMPT_OVERRIDE=false
# M365_ENABLE_DESIGNER_IMAGE_GEN_4O=false
# M365_ENABLE_CODE_CANVAS=false
# M365_ENABLE_SYDNEY_RECONNECT=false

# 可选公网身份策略(仅 Microsoft 网关渠道需要)
# M365_PUBLIC_IDENTITY_POLICY=false

# ---------------------------------------------------------------------------
# 其他 / 调优 / 调试
# ---------------------------------------------------------------------------
# M365_ACCOUNT_CONCURRENCY_LIMIT=8
# M365_ACCOUNT_DEFAULT_CONCURRENCY=8
# M365_SETTINGS_ENV_WINS=false
# M365_SETTINGS_FILE=           # 覆盖 settings.json 位置
# M365_TRACE=                   # chat-hub 帧跟踪(啰嗦)